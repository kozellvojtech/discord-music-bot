# ==========================================
# Discord
# ==========================================

# Token bota z Discord Developer Portalu (sekce Bot -> Reset Token).
# Nikdy ho nikomu neukazuj!
DISCORD_TOKEN=

# ID aplikace z Discord Developer Portalu (sekce General Information -> Application ID).
DISCORD_CLIENT_ID=

# ID tvého Discord serveru, kde má bot fungovat.
# Získáš kliknutím pravým tlačítkem na ikonu serveru -> Kopírovat ID serveru (vyžaduje zapnutý Režim vývojáře v Discordu).
DISCORD_GUILD_ID=

# ==========================================
# Lavalink
# ==========================================

# Verze Lavalink serveru (ghcr.io/lavalink-devs/lavalink).
# Nepoužívej alpine variantu, DAVE potřebuje glibc.
LAVALINK_VERSION=4.2.2

# Heslo pro zabezpečení komunikace mezi botem a Lavalinkem.
# Vymysli si dlouhé náhodné heslo, nikam ho nezadáváš.
LAVALINK_PASSWORD=zmen-me-na-dlouhe-nahodne-heslo

# Parametry paměti pro Java proces Lavalinku.
LAVALINK_JAVA_OPTIONS=-Xmx1G

# ==========================================
# YouTube
# ==========================================

# Verze YouTube pluginu pro Lavalink.
# Snapshot = celý hash commitu; až vyjde oficiální release novější než 1.18.2, dej jeho číslo, např. 1.19.0, a SNAPSHOT=false.
YT_PLUGIN_VERSION=2be8e542d3f6f178e048dca565892684c2e40177

# Zda se jedná o snapshot/commit verzi YouTube pluginu (true) nebo oficiální release (false).
YT_PLUGIN_SNAPSHOT=true

# Verze (tag) Docker image yt-cipher pro dešifrování YouTube podpisů.
YT_CIPHER_TAG=master

# Heslo/token pro komunikaci mezi Lavalinkem a yt-cipher službou.
# Vymysli si dlouhé náhodné heslo, nikam ho nezadáváš.
YT_CIPHER_TOKEN=zmen-me-na-jine-dlouhe-heslo

# Povolení přihlášení přes YouTube OAuth (true/false) při problémech s blokováním botů.
YT_OAUTH_ENABLED=false

# Refresh token získaný při prvním spárování přes YouTube OAuth (viz README).
YT_OAUTH_REFRESH_TOKEN=

# ==========================================
# Spotify
# ==========================================

# Verze pluginu LavaSrc pro načítání Spotify skladeb a playlistů.
LAVASRC_VERSION=4.8.3

# Klientské ID aplikace ze Spotify Developer Dashboardu (Settings -> Client ID).
SPOTIFY_CLIENT_ID=

# Klientský tajný klíč ze Spotify Developer Dashboardu (Settings -> View client secret).
SPOTIFY_CLIENT_SECRET=

# Kód země pro dostupnost skladeb na Spotify (ISO 3166-1 alpha-2 kód).
SPOTIFY_COUNTRY=CZ

# Cookie sp_dc z webového přehrávače open.spotify.com pro načítání cizích playlistů (volitelné).
SPOTIFY_SP_DC=

# Zda preferovat interní Partner API Spotify (nutné nastavit na true při použití SPOTIFY_SP_DC).
SPOTIFY_PREFER_PARTNER_API=false

# ==========================================
# Chování bota
# ==========================================

# Výchozí hlasitost přehrávače po spuštění v procentech (0-150).
DEFAULT_VOLUME=80

# Doba v sekundách, po které se bot odpojí z hlasového kanálu po dohrání fronty.
IDLE_TIMEOUT_SECONDS=180

# Doba v sekundách, po které se bot odpojí, pokud v hlasovém kanálu nezůstane žádný uživatel.
EMPTY_CHANNEL_TIMEOUT_SECONDS=60

# Maximální povolený počet skladeb ve frontě přehrávače.
MAX_QUEUE_SIZE=500
